# Build de l'appli Android (vite build --mode android) : copier vers .env.android et renseigner.
# Mêmes valeurs que sur Vercel (config web Firebase, publique) + l'ID client Web Google.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lifehub-1d337.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifehub-1d337
VITE_FIREBASE_APP_ID=

# API de production (l'appli n'a pas d'API locale)
VITE_API_URL=https://lifehub-api-pryz.onrender.com

# Console Firebase > Authentication > Sign-in method > Google > « ID client Web »
# (finit par .apps.googleusercontent.com). Public, mais propre à ton projet.
VITE_GOOGLE_WEB_CLIENT_ID=

# Jamais l'émulateur dans l'appli
VITE_USE_AUTH_EMULATOR=false
