# Config Firebase web (Console > Paramètres du projet > Vos applications > Config).
# Non secrète, mais gardée hors du repo. Restreindre la clé API par référents HTTP.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Sert uniquement à afficher le bon shell. Les droits réels sont dans firestore.rules.
VITE_ADMIN_EMAIL=

# true = se connecter aux émulateurs locaux (127.0.0.1). Utiliser avec PROJECT_ID=demo-lifehub.
VITE_USE_EMULATORS=false
