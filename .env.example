# Front (Vercel). Config web Firebase : Console > Parametres du projet > Vos applications.
# Non secrete, mais hors du repo. Restreindre la cle API par referents HTTP.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL publique de l API Render, sans slash final (ex. https://lifehub-api.onrender.com)
VITE_API_URL=http://127.0.0.1:8787

# true = emulateur Auth local (127.0.0.1:9099), avec VITE_FIREBASE_PROJECT_ID=demo-lifehub
VITE_USE_AUTH_EMULATOR=false
