# API (Render). Ne jamais committer le vrai fichier .env.
FIREBASE_PROJECT_ID=
ADMIN_EMAIL=
# Chaine Neon (pooled), avec sslmode=require. Vide en local = base PGlite dans api/.data/
DATABASE_URL=
# Origines autorisees (CORS), separees par des virgules
ALLOWED_ORIGINS=http://127.0.0.1:7070
# Local uniquement : accepte les jetons de l emulateur Auth. Refuse au demarrage sur Render.
FIREBASE_AUTH_EMULATOR_HOST=
# Web Push (facultatif). Générer : npx --prefix api web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secret partagé avec le cron qui appelle /api/push/tick (32 caractères minimum).
# En local, le serveur appelle lui-même le tick chaque minute.
PUSH_CRON_SECRET=
