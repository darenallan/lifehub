{
  "name": "lifehub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth --project demo-lifehub",
    "icons": "node scripts/gen-icons.mjs",
    "dev:api": "npm --prefix api run dev",
    "test:api": "npm --prefix api test",
    "check": "npm run lint && npm test && npm run test:api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/syne": "5.3.0"
  }
}
