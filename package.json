{
  "name": "lifehub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lifehub \"npx vitest run --config vitest.rules.config.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-lifehub",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "eslint": "10.12.0",
    "firebase-tools": "15.32.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
